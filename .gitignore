# ============================================================
#  构建产物
# ============================================================
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
.idea/
*.DotSettings.user

# ============================================================
#  【安全关键】绝不允许提交任何凭据 / 本地配置 / 日志
#  这些文件一旦进版本库,就等于把密码公开出去了。
# ============================================================
# 本地配置(含组名、密码、token、服务器地址)
config.json
config.local.json
*.local.json
secrets.json
secrets.dat
credentials.json

# 生成的运行期配置
*.generated.toml
*.runtime.toml
frpc.toml
frps.toml
run.txt
*.secret

# 日志:可能包含服务器地址与客户端信息
*.log
logs/
log/

# 分发/部署脚本里可能嵌了真实地址
deploy.local.*
*.private.*

# user.txt 等旧版手工配置的命名习惯
user.txt

# ============================================================
#  系统与编辑器
# ============================================================
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.tmp
*.bak
*.swp

# 探测/临时目录
# 注意:下面那个 probe-edge 目录里是 edge.exe 的参数探测脚本(不含任何真实凭据),
# 属于一次性验证工具。保留在本地以便复现结论,但不进版本库。
.probe/
.probe-edge/
.tmp/
scratch/
