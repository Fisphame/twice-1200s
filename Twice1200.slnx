  <Project Path="src/Twice1200.Core/Twice1200.Core.csproj" />
  <Project Path="src/Twice1200.Cli/Twice1200.Cli.csproj" />
  <Project Path="tests/Twice1200.SelfTest/Twice1200.SelfTest.csproj" />
</Solution>
