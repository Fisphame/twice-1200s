<Window x:Class="Twice1200.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Twice1200 —— n2n 组网与 frp 穿透"
        Height="720" Width="1020"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen">

    <!--
      界面刻意保持朴素:只用最基础的控件与直接的事件处理。
      没有 MVVM 框架、没有值转换器、没有第三方控件库 ——
      这样一旦出现编译或运行问题,范围小、容易定位。
      等两条链路都稳定跑通之后,再考虑把结构整理得更正规。
    -->

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="6" />
            <RowDefinition Height="220" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 标题 ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Twice1200"
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="n2n 组网与 frp 穿透"
                       Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#666" />
            <TextBlock x:Name="ElevationText"
                       Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#8A6D00" />
        </StackPanel>

        <!-- ===== 功能页 ===== -->
        <TabControl Grid.Row="1" x:Name="FeatureTabs">

            <!-- ===== n2n ===== -->
            <TabItem Header="n2n 组网">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="虚拟网卡名" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="AdapterNameBox"
                               Text="n2n-TAP" Margin="0,0,0,8"
                               ToolTip="建议使用纯 ASCII 名称。含空格或非 ASCII 字符的名称在 n2n 工具链上有已知风险。" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="网络组名" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="CommunityBox" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="超级节点" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="SupernodeBox"
                               Text="" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="本机虚拟 IP" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="VirtualIpBox"
                               Text="" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="网络密码" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="KeyBox" Margin="0,0,0,8" />
                    <Button Grid.Row="4" Grid.Column="2" x:Name="SaveKeyButton"
                            Content="保存密码" Width="90" Margin="8,0,0,8" Click="OnSaveKey" />

                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="KeyStateText"
                               Foreground="#666" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="密码会以 DPAPI 加密保存在本机,不落明文。" />

                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="ConnectButton" Content="连接" Width="96" Height="30"
                                Click="OnConnect" />
                        <Button x:Name="DisconnectButton" Content="断开" Width="96" Height="30"
                                Margin="8,0,0,0" Click="OnDisconnect" IsEnabled="False" />
                        <Button x:Name="PrepareEnvButton" Content="准备环境" Width="110" Height="30"
                                Margin="20,0,0,0" Click="OnPrepareEnvironment"
                                ToolTip="检测并安装 TAP 驱动、创建或重命名虚拟网卡(会请求管理员权限)" />
                        <Button x:Name="LocalVerifyButton" Content="本机自测" Width="110" Height="30"
                                Margin="8,0,0,0" Click="OnLocalVerify"
                                ToolTip="在本机起一个超级节点并连它,用于确认客户端本身是否正常" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== frp ===== -->
            <TabItem Header="frp 穿透">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="服务端地址" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="FrpServerBox"
                               Text="" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="控制端口" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="FrpPortBox"
                               Text="7000" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="鉴权 token" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="FrpTokenBox" Margin="0,0,0,8" />
                    <Button Grid.Row="2" Grid.Column="2" x:Name="SaveTokenButton"
                            Content="保存 token" Width="90" Margin="8,0,0,8" Click="OnSaveFrpToken" />

                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FrpTokenStateText"
                               Foreground="#666" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="token 会以 DPAPI 加密保存在本机,不落明文。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="端口映射" VerticalAlignment="Top" Margin="0,4,0,8" />

                    <DockPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="FrpAddRuleButton" Content="添加规则" Width="88" Height="26"
                                    Click="OnFrpAddRule" />
                            <Button x:Name="FrpRemoveRuleButton" Content="删除选中" Width="88" Height="26"
                                    Margin="8,0,0,0" Click="OnFrpRemoveRule" />
                            <TextBlock x:Name="FrpRuleSummaryText" VerticalAlignment="Center"
                                       Margin="12,0,0,0" Foreground="#666" />
                        </StackPanel>

                        <DataGrid x:Name="FrpRulesGrid" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" Height="150"
                                  SelectionMode="Single" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="规则名" Binding="{Binding Name}" Width="120" />
                                <DataGridTextColumn Header="本地 IP" Binding="{Binding LocalIp}" Width="110" />
                                <DataGridTextColumn Header="本地端口" Binding="{Binding LocalPort}" Width="80" />
                                <DataGridTextColumn Header="服务端端口" Binding="{Binding RemotePort}" Width="90" />
                                <DataGridComboBoxColumn Header="类型" SelectedItemBinding="{Binding Type}" Width="80">
                                    <DataGridComboBoxColumn.ItemsSource>
                                        <x:Array Type="sys:String">
                                            <sys:String>tcp</sys:String>
                                            <sys:String>udp</sys:String>
                                        </x:Array>
                                    </DataGridComboBoxColumn.ItemsSource>
                                </DataGridComboBoxColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <CheckBox Grid.Row="5" Grid.Column="1" x:Name="FrpTlsCheck"
                              Content="启用 TLS(建议保持勾选)" IsChecked="True" Margin="0,0,0,10" />

                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="FrpConnectButton" Content="启动映射" Width="96" Height="30"
                                Click="OnFrpConnect" />
                        <Button x:Name="FrpDisconnectButton" Content="停止" Width="96" Height="30"
                                Margin="8,0,0,0" Click="OnFrpDisconnect" IsEnabled="False" />
                        <Button x:Name="FrpPreviewButton" Content="预览配置" Width="110" Height="30"
                                Margin="20,0,0,0" Click="OnFrpPreview"
                                ToolTip="只展示将要生成的 frpc 配置(token 打码),不写入文件也不启动进程" />
                        <Button x:Name="FrpTestServerButton" Content="检测服务端" Width="110" Height="30"
                                Margin="8,0,0,0" Click="OnFrpTestServer" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ===== 日志 ===== -->
        <DockPanel Grid.Row="3">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="日志" FontWeight="Bold" VerticalAlignment="Center" />
                <Button x:Name="RunDoctorButton" Content="环境体检" Width="90" Height="24"
                        Margin="12,0,0,0" Click="OnRunDoctor" />
                <Button x:Name="CopyLogButton" Content="复制日志" Width="90" Height="24"
                        Margin="6,0,0,0" Click="OnCopyLog" />
                <Button x:Name="ClearLogButton" Content="清空" Width="70" Height="24"
                        Margin="6,0,0,0" Click="OnClearLog" />
                <TextBlock x:Name="LogSummaryText" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="#666" />
            </StackPanel>

            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, 等线, monospace"
                     FontSize="12" />
        </DockPanel>

        <!-- ===== 状态栏 ===== -->
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="8,6"
                Background="#F4F4F4" BorderBrush="#DDD" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StateText" Text="未连接" FontWeight="Bold" />
                <TextBlock Grid.Column="1" x:Name="StatusText" Margin="12,0" TextWrapping="Wrap"
                           Text="就绪。" />
                <ProgressBar Grid.Column="2" x:Name="BusyBar" Width="120" Height="16"
                             IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
