<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 纯托管目标,不依赖 Windows。这让 Core 可以在任意平台编译与测试 -->
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Twice1200.Core</RootNamespace>
    <AssemblyName>Twice1200.Core</AssemblyName>

    <!-- 明确:Core 不引用任何 Windows 专属 API。
         WMI / 注册表 / 网卡驱动名等 Windows 相关能力,
         通过平台能力接口在 Cli / App 层注入。 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
